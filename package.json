{
  "name": "@luwenjiede/dsh-vaultx",
  "version": "0.1.0",
  "description": "DSH VaultX — 终极密码箱。AES-256-GCM + scrypt 信封加密静态存储（取自 dsh-vault 的密码学内核），密钥值永不进入模型上下文、经 $DSH_* shellEnv 带外注入 shell（取自 dsh-key-panel 的零暴露设计），并以 fail-open 解锁 + 操作员策略 + 哈希链审计 + 双语文案设置面板补齐两者短板。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "bin",
    "docs",
    "cordis.patch.yml",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "vaultx": "bin/vaultx.mjs"
  },
  "scripts": {
    "test": "node --test test/crypto.test.mjs test/totp.test.mjs test/strength.test.mjs test/store.test.mjs test/policy.test.mjs test/audit.test.mjs test/breach.test.mjs test/tools.test.mjs test/contracts.test.mjs test/client.test.mjs",
    "contracts": "node test/contracts.test.mjs",
    "test:quick": "node --test test/crypto.test.mjs test/totp.test.mjs test/strength.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "keywords": [
      "dsh-plugin",
      "password-manager",
      "vault",
      "credentials",
      "totp",
      "secrets",
      "shell-env"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luwenjiede/dsh-vaultx.git"
  },
  "homepage": "https://github.com/luwenjiede/dsh-vaultx#readme",
  "bugs": {
    "url": "https://github.com/luwenjiede/dsh-vaultx/issues"
  },
  "author": "luwenjiede",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}